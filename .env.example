# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# MySQL connection
# Local dev (XAMPP/MariaDB): DB_USER=root, DB_PASSWORD= (blank)
# Production: create a dedicated MySQL user with a strong password, scoped
# to only the checkin_db database — do not use root in production.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=checkin_db

# Auth — generate a fresh, unique secret for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse a secret across environments; rotating it logs out all staff.
JWT_SECRET=

# API server
# HOST=127.0.0.1 keeps the Node process reachable only from the same
# machine — required in production, where Nginx reverse-proxies to it.
API_PORT=8787
HOST=127.0.0.1

# Used only by `npm run dev` (Vite proxy target for local development)
VITE_API_PROXY_TARGET=http://localhost:8787
